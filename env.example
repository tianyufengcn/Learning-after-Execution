# Learning after Execution with Action-Specific Credit
# Copy this file to env.local, edit the paths, then run:
#   source env.local

# ---------------------------------------------------------------------------
# Models / reward
# ---------------------------------------------------------------------------
export BASE_MODEL=/path/to/Qwen3-VL-8B-Instruct
export INIT_ADAPTER=/path/to/warm_start_adapter
export RSIM_MODEL_PATH=/path/to/rsim_vision_model

# Optional evaluation metric assets
export I2T_DINO_MODEL=/path/to/dino-vits16
export I2T_SIGLIP_MODEL=/path/to/siglip-so400m-patch14-384
export I2T_DREAMSIM_CACHE=/path/to/dreamsim_cache

# ---------------------------------------------------------------------------
# Training data (not distributed with this code repository)
# ---------------------------------------------------------------------------
export TRAIN_MANIFEST=/path/to/sft_train_manifest.jsonl
export RL_DATASET=/path/to/rl_dataset

# ---------------------------------------------------------------------------
# Runtime / output
# ---------------------------------------------------------------------------
export TEXLIVE_BIN=/path/to/texlive/bin/x86_64-linux
export OUTPUT_ROOT=/path/to/output_dir

# ---------------------------------------------------------------------------
# Evaluation data / checkpoint (not distributed with this repository)
# ---------------------------------------------------------------------------
export EVAL_ADAPTER=/path/to/checkpoint
export EVAL_MANIFEST=/path/to/eval_manifest.jsonl
# Optional: only needed when paths inside EVAL_MANIFEST are relative.
export EVAL_GT_ROOT=/path/to/dataset_root

# Optional evaluation controls
export EVAL_POLICY=checkpoint
export EVAL_GPUS=0,1,2,3
export EVAL_REPLICAS_PER_GPU=3
export EVAL_SEED=20260825

# Direct-SFT package uses I2T_* environment names internally. The launcher also
# maps the generic variables automatically; these exports are only useful when
# invoking the package directly.
export I2T_MODEL="${BASE_MODEL:-}"
export I2T_DATA_SOURCE="${TRAIN_MANIFEST:-}"
export I2T_OUTPUT_ROOT="${OUTPUT_ROOT:-}"
