# Learning after Execution with Action-Specific Credit
# Copy to env.local, edit the local paths, then run:
#   source env.local

# Models / reward
export BASE_MODEL=/path/to/Qwen3-VL-8B-Instruct
export INIT_ADAPTER=/path/to/warm_start_adapter
export RSIM_MODEL_PATH=/path/to/rsim_vision_model

# Training data (not distributed with this code repository)
export TRAIN_MANIFEST=/path/to/sft_train_manifest.jsonl
export RL_DATASET=/path/to/rl_dataset

# Runtime / output
export TEXLIVE_BIN=/path/to/texlive/bin/x86_64-linux
export OUTPUT_ROOT=/path/to/output_dir

# Optional assets for the paper's image metrics in src/metrics.py
export I2T_DINO_MODEL=/path/to/dino-vits16
export I2T_SIGLIP_MODEL=/path/to/siglip-so400m-patch14-384
export I2T_DREAMSIM_CACHE=/path/to/dreamsim_cache
export I2T_RSIM_MODEL=/path/to/detikzify_checkpoint

# Direct-SFT uses I2T_* environment names internally. The launcher maps the
# generic variables automatically; these are useful only for direct invocation.
export I2T_MODEL="${BASE_MODEL:-}"
export I2T_DATA_SOURCE="${TRAIN_MANIFEST:-}"
export I2T_OUTPUT_ROOT="${OUTPUT_ROOT:-}"
